# =============================================================================
# ZeroAgent-Scan / EndpointGuard EMS — ROOT PRODUCTION ENVIRONMENT (.env.production)
# =============================================================================

ENVIRONMENT=production
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Production Database Identifiers
POSTGRES_DB=endpointguard_prod
POSTGRES_USER=endpointguard_prod_svc
DATABASE_URL=postgres://endpointguard_prod_svc:REPLACE_WITH_SECURE_VAULT_PASSWORD@db-cluster.prod.corp.local:5432/endpointguard_prod?sslmode=verify-full&sslrootcert=C:\apps\zeroagent\certs\postgres-root-ca.crt

# Application URLs
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
ALLOWED_ORIGINS=https://zeroagent.corp.local,https://dashboard.zeroagent.corp.local,http://localhost:3000,http://127.0.0.1:3000

# Real Agentless WinRM Scans (Mock mode forbidden)
MOCK_SCAN_MODE=false

# Production Master Key (Must be generated uniquely via 'openssl rand -hex 32')
VAULT_MASTER_KEY_HEX=__GENERATE_32_BYTE_HEX_KEY_USING_OPENSSL_RAND_HEX_32__
