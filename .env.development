# =============================================================================
# ZeroAgent-Scan / EndpointGuard EMS — ROOT DEVELOPMENT ENVIRONMENT (.env.development)
# =============================================================================

ENVIRONMENT=development
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Database Identifiers
POSTGRES_DB=endpointguard_dev
POSTGRES_USER=endpointguard_dev_app
POSTGRES_PASSWORD=endpointguard_dev_insecure_local_password
DATABASE_URL=postgres://endpointguard_dev_app:endpointguard_dev_insecure_local_password@localhost:5432/endpointguard_dev?sslmode=disable

# API & Gateway Ports
API_PORT=8080
DASHBOARD_PORT=3000
MOCK_SCAN_MODE=true

# Development Keys
VAULT_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXT_PUBLIC_API_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
