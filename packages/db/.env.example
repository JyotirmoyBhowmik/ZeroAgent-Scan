# PostgreSQL connection URL for database migrations and sqlc tooling
# Format: postgres://<user>:<password>@<host>:<port>/<database>?sslmode=<disable|require>
DATABASE_URL=postgres://endpointguard_app:endpointguard_secure_dev_password_change_in_prod@localhost:5432/endpointguard?sslmode=disable

# PostgreSQL Database Admin User (used for running DDL migrations)
POSTGRES_USER=endpointguard_app

# PostgreSQL Database Admin Password (never use default in production)
POSTGRES_PASSWORD=endpointguard_secure_dev_password_change_in_prod

# PostgreSQL Database Name
POSTGRES_DB=endpointguard

# PostgreSQL Host & Port
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
