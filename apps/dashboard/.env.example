# ===========================================================================
# EndpointGuard Next.js 14 Dashboard Environment Configuration (.env.example)
# ===========================================================================

# Public URL of the Control Plane API (Go Chi service)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Environment mode (development, production)
NODE_ENV=development

# Optional Analytics or Telemetry endpoint
NEXT_PUBLIC_TELEMETRY_ENABLED=false
