# =============================================================================
# ZeroAgent-Scan Web Dashboard — PRODUCTION CONFIGURATION
# =============================================================================

# Public Production URL of the Control Plane API (or routed via IIS Reverse Proxy)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Production Environment Mode (Hides development warning banner)
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Telemetry
NEXT_PUBLIC_TELEMETRY_ENABLED=true
