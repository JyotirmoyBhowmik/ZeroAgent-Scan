# ===========================================================================
# EndpointGuard On-Prem Subnet Collector Gateway (.env.example)
# ===========================================================================

# Unique Subnet Collector Gateway Identifier
GATEWAY_ID=gw-subnet-10-100-1-0

# Subnet CIDR monitored by this gateway
SUBNET_CIDR=10.100.1.0/24

# Central Control Plane API Endpoint
CONTROL_PLANE_URL=http://localhost:8080

# Heartbeat & Telemetry interval (seconds)
HEARTBEAT_INTERVAL_SEC=10

# mTLS Certificate & Key Paths (for authenticating to Central Control Plane)
# In production, gateway requires a client certificate signed by the enterprise CA
MTLS_CLIENT_CERT_PATH=/etc/endpointguard/certs/gateway.crt
MTLS_CLIENT_KEY_PATH=/etc/endpointguard/certs/gateway.key
MTLS_CA_CERT_PATH=/etc/endpointguard/certs/ca.crt

# Local scan engine execution timeouts
SCAN_PROBE_TIMEOUT_SEC=30

# Structured Logging Level
LOG_LEVEL=info
