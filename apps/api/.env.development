# =============================================================================
# ZeroAgent-Scan / EndpointGuard Control Plane API — DEVELOPMENT CONFIGURATION
# (Visibly distinct 'dev' identifiers — 100% Isolated from Production)
# =============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
NODE_ENV=development
SERVICE_NAME=endpointguard-api-dev

# Local Development Database URL (Explicitly named 'endpointguard_dev')
DATABASE_URL=postgres://endpointguard_dev_app:endpointguard_dev_insecure_local_password@localhost:5432/endpointguard_dev?sslmode=disable

# Safe Simulation Mode (6-stage agentless scan pipeline simulator)
MOCK_SCAN_MODE=true

# Dummy Local Development Vault Master Key (AES-256-GCM)
# 64 hex characters (32 bytes) — Insecure dev key, rejected by production boot guard
VAULT_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Signing Secret for Development Sessions
JWT_SIGNING_SECRET=development-only-jwt-signing-key-not-for-prod-32b!

# Allowed Web Origins (Local Next.js Dashboard)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Subnet Collector Gateway Settings
MTLS_ENFORCE_CLIENT_AUTH=false

# Rate Limiting & Logging
RATE_LIMIT_RPS=200
RATE_LIMIT_BURST=500
LOG_LEVEL=debug
