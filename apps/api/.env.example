# ===========================================================================
# EndpointGuard Control Plane API Environment Configuration (.env.example)
# ===========================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# Database Connection URL (PostgreSQL 15+)
# In production, use managed connection pooler (e.g. AWS RDS Proxy, PgBouncer)
DATABASE_URL=postgres://endpointguard_app:endpointguard_secure_dev_password_change_in_prod@localhost:5432/endpointguard?sslmode=disable

# Dedicated Credential Vault Master Key (AES-256-GCM Envelope Encryption)
# MUST be a 64-character (32-byte) hex string. Never commit real production keys.
# Generate in prod using: openssl rand -hex 32
VAULT_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Subnet Collector Gateway mTLS Settings
# Path to CA certificate bundle used to verify on-prem collector gateway client certs
MTLS_CA_CERT_PATH=/etc/endpointguard/certs/ca.crt
MTLS_SERVER_CERT_PATH=/etc/endpointguard/certs/server.crt
MTLS_SERVER_KEY_PATH=/etc/endpointguard/certs/server.key
MTLS_ENFORCE_CLIENT_AUTH=false

# Allowed CORS Origins (Comma-separated list of trusted web origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & DoS Mitigation (OWASP ASVS Rule 3.3)
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Structured JSON Logging & Observability
LOG_LEVEL=info
SERVICE_NAME=endpointguard-api
