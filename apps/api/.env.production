# =============================================================================
# ZeroAgent-Scan / EndpointGuard Control Plane API — PRODUCTION CONFIGURATION
# (Visibly distinct 'prod' identifiers & enforced security parameters)
# =============================================================================

# Production Server Network Configuration
PORT=8080
HOST=127.0.0.1
ENVIRONMENT=production
NODE_ENV=production
SERVICE_NAME=endpointguard-api-prod

# Production Database URL (Strict TLS + Managed Service Account)
# Notice 'endpointguard_prod' database name and 'sslmode=verify-full'
DATABASE_URL=postgres://endpointguard_prod_svc:REPLACE_WITH_SECURE_VAULT_PASSWORD@db-cluster.prod.corp.local:5432/endpointguard_prod?sslmode=verify-full&sslrootcert=C:\apps\zeroagent\certs\postgres-root-ca.crt

# Real Agentless WinRM/DCOM Network Scanning (Mock mode strictly forbidden)
MOCK_SCAN_MODE=false

# Production Dedicated AES-256-GCM Vault Master Key
# MUST be generated uniquely per tenant using: openssl rand -hex 32
# The boot-time guard will ABORT startup if this matches the default dev key!
VAULT_MASTER_KEY_HEX=__GENERATE_32_BYTE_HEX_KEY_USING_OPENSSL_RAND_HEX_32__

# Production Cryptographic JWT Secret (Minimum 256-bit entropy)
JWT_SIGNING_SECRET=__GENERATE_STRONG_RANDOM_JWT_SECRET_KEY_MIN_32_CHARS__

# Production Web Origins
ALLOWED_ORIGINS=https://zeroagent.corp.local,https://dashboard.zeroagent.corp.local

# Subnet Collector Gateway mTLS Enforcement
MTLS_CA_CERT_PATH=C:\apps\zeroagent\certs\gateway-ca.crt
MTLS_SERVER_CERT_PATH=C:\apps\zeroagent\certs\api-server.crt
MTLS_SERVER_KEY_PATH=C:\apps\zeroagent\certs\api-server.key
MTLS_ENFORCE_CLIENT_AUTH=true

# Production Rate Limiting & Observability
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
LOG_LEVEL=info
